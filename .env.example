# Copy to .env to turn on the assistant outside claude.ai.

# The editor posts { messages } here and expects the JSON operations object back.
VITE_AI_ENDPOINT=/api/ai

# Used only by server/ai-proxy.mjs (never exposed to the browser).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PROXY_PORT=8787
